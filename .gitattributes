# 统一换行符为 LF，避免 Windows 环境写入 CRLF 导致整文件 diff
* text=auto eol=lf

# 明确文本类型
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.styl  text eol=lf
*.html  text eol=lf
*.ejs   text eol=lf

# 二进制文件不参与换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.svg   text eol=lf
